-- Clientes que han hecho pedidos
SELECT c.nombre, p.id_pedido, p.fecha
FROM clientes c
INNER JOIN pedidos p
ON c.id_cliente = p.id_cliente;


-- Todos los clientes compren o no
SELECT c.nombre, p.id_pedido
FROM clientes c
LEFT JOIN pedidos p
ON c.id_cliente = p.id_cliente;

-- Todos los pedidos asi el cliente no exista
SELECT c.nombre, p.id_pedido
FROM clientes c
RIGHT JOIN pedidos p
ON c.id_cliente = p.id_cliente;

--muestra todo clientes, y pedidos asi haiga o no
SELECT c.nombre, p.id_pedido
FROM clientes c
LEFT JOIN pedidos p
ON c.id_cliente = p.id_cliente

UNION

SELECT c.nombre, p.id_pedido
FROM clientes c
RIGHT JOIN pedidos p
ON c.id_cliente = p.id_cliente;

-- Todos los clientes con todos los productos
SELECT c.nombre, pr.nombre_producto
FROM clientes c
CROSS JOIN productos pr;

-- JOIN MULTIPLE (4 tablas)
-- Qué compró cada cliente
SELECT c.nombre, pr.nombre_producto, dp.cantidad
FROM clientes c
JOIN pedidos p ON c.id_cliente = p.id_cliente
JOIN detalle_pedido dp ON p.id_pedido = dp.id_pedido
JOIN productos pr ON dp.id_producto = pr.id_producto;

-- Clientes que compraron laptop o teclado(union mas join)
SELECT c.nombre, pr.nombre_producto
FROM clientes c
JOIN pedidos p ON c.id_cliente = p.id_cliente
JOIN detalle_pedido dp ON p.id_pedido = dp.id_pedido
JOIN productos pr ON dp.id_producto = pr.id_producto
WHERE pr.nombre_producto = 'Laptop'

UNION

SELECT c.nombre, pr.nombre_producto
FROM clientes c
JOIN pedidos p ON c.id_cliente = p.id_cliente
JOIN detalle_pedido dp ON p.id_pedido = dp.id_pedido
JOIN productos pr ON dp.id_producto = pr.id_producto
WHERE pr.nombre_producto = 'Teclado';
