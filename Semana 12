-- FUNCION DE TEXTO (cadena)
SELECT UPPER(titulo) AS Titulo_Mayuscula
FROM Libros;

-- FUNCION DE CONVERSION DE TIPO
SELECT CAST(paginas AS CHAR) AS Paginas_Texto
FROM Libros;

-- FUNCION DE FECHA
SELECT YEAR(fecha_publicacion) AS Anio_Publicacion
FROM Libros;

-- SUBCONSULTA CON IN
SELECT titulo
FROM Libros
WHERE id_autor IN (
    SELECT id_autor
    FROM Autores
    WHERE nacionalidad = 'Peruano'
);

-- SUBCONSULTA CON EXISTS
SELECT nombre
FROM Autores a
WHERE EXISTS (
    SELECT 1
    FROM Libros l
    WHERE l.id_autor = a.id_autor
);
