-- Crear la base de datos
CREATE DATABASE Biblioteca12;
USE Biblioteca12;

-- Tabla de autores
CREATE TABLE Autores (
    id_autor INT PRIMARY KEY,
    nombre VARCHAR(50),
    nacionalidad VARCHAR(30)
);

-- Tabla de libros
CREATE TABLE Libros (
    id_libro INT PRIMARY KEY,
    titulo VARCHAR(100),
    fecha_publicacion DATE,

