CREATE DATABASE ClinicaDentalDB;
USE ClinicaDentalDB;


-- TABLA PACIENTES
CREATE TABLE Pacientes (
    id_paciente INT IDENTITY(1,1) PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    telefono VARCHAR(20),
    direccion VARCHAR(150)
);

-- TABLA ODONTOLOGOS
CREATE TABLE Odontologos (
    id_odontologo INT IDENTITY(1,1) PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    especialidad VARCHAR(50),
    telefono VARCHAR(20)
);

-- TABLA CITAS
CREATE TABLE Citas (
    id_cita INT IDENTITY(1,1) PRIMARY KEY,
    id_paciente INT NOT NULL,
    id_odontologo INT NOT NULL,
    fecha DATE NOT NULL,
    hora TIME NOT NULL,
    estado VARCHAR(30) DEFAULT 'Programada',

    CONSTRAINT FK_Citas_Pacientes
        FOREIGN KEY (id_paciente)
        REFERENCES Pacientes(id_paciente),

    CONSTRAINT FK_Citas_Odontologos
        FOREIGN KEY (id_odontologo)
        REFERENCES Odontologos(id_odontologo)
);

