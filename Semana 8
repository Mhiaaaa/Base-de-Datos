--
CREATE PROCEDURE ProcesarCita
    @PacienteID INT,
    @MedicoID INT,
    @Monto DECIMAL(10,2)
AS
BEGIN
    BEGIN TRANSACTION;

    BEGIN TRY
        -- Crear cita
        INSERT INTO Citas (PacienteID, MedicoID, FechaCita, Estado)
        VALUES (@PacienteID, @MedicoID, GETDATE(), 'Atendida');

        DECLARE @CitaID INT = SCOPE_IDENTITY();

        -- Registrar pago
        INSERT INTO Pagos (CitaID, Monto, FechaPago)
        VALUES (@CitaID, @Monto, GETDATE());

        COMMIT TRANSACTION;
    END TRY
    BEGIN CATCH
        ROLLBACK TRANSACTION;
        THROW;
    END CATCH
END;

--

CREATE FUNCTION fn_CantidadCitas (@PacienteID INT)
RETURNS INT
AS
BEGIN
    DECLARE @Cantidad INT;

    SELECT @Cantidad = COUNT(*)
    FROM Citas
    WHERE PacienteID = @PacienteID;

    RETURN @Cantidad;
END;

