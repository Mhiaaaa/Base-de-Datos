    P.Nombres,
    COUNT(C.CitaID) AS CantidadCitas,
    SUM(PA.Monto) AS TotalPagado
FROM Pacientes P
JOIN Citas C ON P.PacienteID = C.PacienteID
JOIN Pagos PA ON C.CitaID = PA.CitaID
GROUP BY P.Nombres;
